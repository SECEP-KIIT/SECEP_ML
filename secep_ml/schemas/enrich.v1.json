{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "enrich.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary_one_line",
    "summary_short",
    "actions"
  ],
  "properties": {
    "summary_one_line": {
      "type": "string",
      "maxLength": 160
    },
    "summary_short": {
      "type": "string",
      "maxLength": 600
    },
    "actions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title",
          "description",
          "priority",
          "due_date",
          "start",
          "end",
          "attendees"
        ],
        "properties": {
          "type": {
            "enum": [
              "create_jira_issue",
              "add_board_card",
              "add_calendar_event",
              "none"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 120
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "priority": {
            "enum": [
              "Highest",
              "High",
              "Medium",
              "Low",
              null
            ]
          },
          "due_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "start": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "end": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "attendees": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string",
              "format": "email"
            }
          }
        }
      }
    }
  }
}