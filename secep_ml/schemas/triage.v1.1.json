{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "triage.v1.1",
  "description": "ML-side triage output. A superset of triage.v1: to_triage_v1() drops the extras and the result validates against triage.v1. Adds per-head needs_review (threshold 0.60), per-head probabilities and source, review_heads (I1 head names), and provenance (manifest hash, text recipe version, input hash).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "email_id",
    "email_type",
    "urgency",
    "sentiment",
    "needs_review",
    "review_heads",
    "model_version",
    "manifest_sha256",
    "text_version",
    "input_sha256",
    "processed_at"
  ],
  "properties": {
    "schema": {
      "const": "triage.v1.1"
    },
    "email_id": {
      "type": "string",
      "format": "uuid"
    },
    "email_type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "confidence",
        "source",
        "needs_review",
        "probs"
      ],
      "properties": {
        "label": {
          "enum": [
            "Task",
            "Info",
            "Credentials",
            "Meeting",
            "Approval"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source": {
          "enum": [
            "encoder",
            "llm",
            "user",
            "rule"
          ]
        },
        "needs_review": {
          "type": "boolean"
        },
        "probs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Task",
            "Info",
            "Credentials",
            "Meeting",
            "Approval"
          ],
          "properties": {
            "Task": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "Info": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "Credentials": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "Meeting": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "Approval": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "urgency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "confidence",
        "source",
        "needs_review",
        "probs"
      ],
      "properties": {
        "label": {
          "enum": [
            "Critical",
            "High",
            "Medium",
            "Low"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source": {
          "enum": [
            "encoder",
            "llm",
            "user",
            "rule"
          ]
        },
        "needs_review": {
          "type": "boolean"
        },
        "probs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Critical",
            "High",
            "Medium",
            "Low"
          ],
          "properties": {
            "Critical": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "High": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "Medium": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "Low": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "sentiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "confidence",
        "source",
        "needs_review",
        "probs",
        "score"
      ],
      "properties": {
        "label": {
          "enum": [
            "Positive",
            "Neutral",
            "Negative",
            "Frustrated"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source": {
          "enum": [
            "encoder",
            "llm",
            "user",
            "rule"
          ]
        },
        "needs_review": {
          "type": "boolean"
        },
        "probs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Positive",
            "Neutral",
            "Negative",
            "Frustrated"
          ],
          "properties": {
            "Positive": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "Neutral": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "Negative": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "Frustrated": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "score": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      }
    },
    "needs_review": {
      "type": "boolean"
    },
    "review_heads": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "type",
          "urgency",
          "sentiment"
        ]
      }
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "text_version": {
      "type": "string"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "unseen": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string"
        },
        "position": {
          "type": "string"
        }
      }
    },
    "processed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}